//example for spin waves in ferromagnets, created by chatgpt (although with documentation it shouln't be that hard to do it yourself)
//set frequency
f := 5e9

//set geom
SetGridSize(256,32,1)
SetCellSize(2e-9,2e-9,4e-9)
SetGeom(Rect(512e-9,64e-9))

//define controlling region (creates spin waves)
DefRegion(1, Rect(10e-9, 64e-9).transl(-256e-9,0,0))

//define measurement regions
DefRegion(2, Rect(10e-9, 64e-9).transl(-40e-9,0,0))
DefRegion(3, Rect(10e-9, 64e-9).transl(-10e-9,0,0))
DefRegion(4, Rect(10e-9, 64e-9).transl(25e-9,0,0))

//parameters
Msat = 800e3
Aex = 13e-12
alpha = 0.01

//equilibrium
m = uniform(1,0,0)
save(regions)
relax()
save(m)

//sinusoidal excitation
B_ext.setRegion(1, vector(0,0, 1e-3 * sin(2*pi*f*t)))

//save states and measurements
autosave(m, 2e-11)
tableadd(m.Region(1))
tableadd(m.Region(2))
tableadd(m.Region(3))
tableadd(m.Region(4))
tableautosave(2e-11)

run(5e-9)
